{
  "name": "conexiones-industria",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "NODE_OPTIONS=--conditions=react-server playwright test",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,supavisor,edge-runtime,realtime,postgres-meta",
    "db:reset": "supabase db reset",
    "db:types": "SUPABASE_DB_PASSWORD=postgres supabase gen types typescript --local > lib/server/database.types.ts.tmp && mv lib/server/database.types.ts.tmp lib/server/database.types.ts || (rm -f lib/server/database.types.ts.tmp; exit 1)",
    "admin:add": "tsx --conditions=react-server scripts/admin-add.ts",
    "spike": "tsx --conditions=react-server scripts/spike.ts",
    "docx:inspect": "tsx --conditions=react-server scripts/docx-inspect.ts",
    "docx:split": "tsx --conditions=react-server scripts/split-annexes.ts",
    "mail:test": "tsx scripts/mail-test.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "docxtemplater": "^3.71.0",
    "docxtemplater-image-module-free": "^1.1.1",
    "mammoth": "^1.13.0",
    "next": "^16.3.6",
    "pizzip": "^3.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "supabase": "^2.118.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "docxtemplater-image-module-free": {
      "xmldom": "npm:@xmldom/xmldom@^0.8.11"
    }
  }
}
