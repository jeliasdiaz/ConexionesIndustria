# Copiar a .env y completar. Nunca versionar .env (S18).

# --- Fase 0 (spike) ---
GOTENBERG_URL=http://127.0.0.1:3001
GOTENBERG_USER=dev
GOTENBERG_PASSWORD=
# Prueba de entrega de correo (H6, H10): dominio verificado en Resend.
RESEND_API_KEY=
MAIL_FROM="Conexiones con la Industria uninorte <no-responder@tu-dominio.example>"
# Hasta 3 cuentas institucionales de prueba, separadas por coma (H10).
MAIL_TEST_TO=

# --- Fases 1+ (§17) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OTP_PEPPER=
SESSION_SECRET=
CRON_SECRET=
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITEKEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
# Regla 10: nada destructivo por defecto.
PURGE_ENABLED=false
MAIL_CONFIRMATION_ENABLED=true
