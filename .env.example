# Plantilla de variables. Nunca versionar los archivos reales (S18).
# · .env.local → desarrollo local (npm run dev, pruebas). Gana sobre .env.
# · .env       → operación del proyecto alojado (p. ej. `ENV_FILE=.env npm run admin:add`).
# Las pruebas de integración y E2E se niegan a correr si SUPABASE_URL no es local.

# URL pública de la app: origen permitido en los POST (S19) y destino del
# magic link de admin.
APP_URL=http://localhost:3000

# --- Supabase (§17) ---
# Local: `npm run db:start` (puertos 554xx) y luego `npx supabase status -o env`
# (API_URL → SUPABASE_URL, ANON_KEY, SERVICE_ROLE_KEY).
SUPABASE_URL=http://127.0.0.1:55421
# Solo la usa el servidor para el login de admin; el navegador no habla con Supabase.
SUPABASE_ANON_KEY=
# S1: sin prefijo NEXT_PUBLIC_. Solo servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gotenberg (S10) ---
GOTENBERG_URL=http://127.0.0.1:3001
GOTENBERG_USER=dev
GOTENBERG_PASSWORD=

# Regla 10: nada destructivo por defecto.
PURGE_ENABLED=false

# --- Flujo del estudiante (Fase 2) ---
# `openssl rand -base64 32` para cada uno; distintos en cada entorno.
OTP_PEPPER=
SESSION_SECRET=
# mailpit (local y CI) o resend (producción, obligatorio en Vercel).
MAIL_DRIVER=mailpit
MAIL_FROM="Conexiones con la Industria <no-responder@tu-dominio.example>"
# Mailpit de Supabase local: códigos OTP, magic link y confirmaciones.
MAILPIT_URL=http://127.0.0.1:55424
RESEND_API_KEY=
MAIL_CONFIRMATION_ENABLED=true
# Turnstile. Local: claves de prueba de Cloudflare (siempre pasan). En
# producción el secreto es obligatorio.
NEXT_PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# --- Pruebas ---
# Opcional: Chromium preinstalado para `npm run test:e2e`.
# PW_CHROMIUM_PATH=

# --- Fase 0: prueba de entrega de correo (H6, H10) ---
# Hasta 3 cuentas institucionales de prueba, separadas por coma (H10).
MAIL_TEST_TO=

# --- Pendientes (§17) ---
CRON_SECRET=
SENTRY_DSN=
