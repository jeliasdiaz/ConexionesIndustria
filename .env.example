# Copiar a .env y completar. Nunca versionar .env (S18).

# URL pública de la app: origen permitido en los POST (S19) y destino del
# magic link de admin.
APP_URL=http://localhost:3000

# --- Supabase (§17) ---
# Local: `npm run db:start` y luego `npx supabase status -o env`
# (API_URL → SUPABASE_URL, ANON_KEY, SERVICE_ROLE_KEY).
SUPABASE_URL=
# Solo la usa el servidor para el login de admin; el navegador no habla con Supabase.
SUPABASE_ANON_KEY=
# S1: sin prefijo NEXT_PUBLIC_. Solo servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gotenberg (S10) ---
GOTENBERG_URL=http://127.0.0.1:3001
GOTENBERG_USER=dev
GOTENBERG_PASSWORD=

# Regla 10: nada destructivo por defecto.
PURGE_ENABLED=false

# --- Pruebas ---
# Mailpit de Supabase local (lee los magic link en las pruebas de integración).
MAILPIT_URL=http://127.0.0.1:54324
# Opcional: Chromium preinstalado para `npm run test:e2e`.
# PW_CHROMIUM_PATH=

# --- Fase 0: prueba de entrega de correo (H6, H10) ---
RESEND_API_KEY=
MAIL_FROM="Conexiones con la Industria uninorte <no-responder@tu-dominio.example>"
# Hasta 3 cuentas institucionales de prueba, separadas por coma (H10).
MAIL_TEST_TO=

# --- Fases 2+ (§17) ---
OTP_PEPPER=
SESSION_SECRET=
CRON_SECRET=
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITEKEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
MAIL_CONFIRMATION_ENABLED=true
